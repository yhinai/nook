{
  "name": "nook-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/*.test.ts --bundle --platform=node --format=esm --packages=external --outdir=.test && node --test .test/*.test.js",
    "demo": "esbuild scripts/demo.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/demo.mjs && node --env-file-if-exists=.env dist/demo.mjs",
    "verify:live": "esbuild scripts/verify-live.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/verify-live.mjs && node --env-file-if-exists=.env dist/verify-live.mjs"
  },
  "dependencies": {
    "@mastra/core": "1.74.0",
    "@onkernel/sdk": "0.119.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
