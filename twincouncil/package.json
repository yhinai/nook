{
  "name": "twincouncil",
  "version": "0.1.0",
  "private": true,
  "description": "TwinCouncil: a digital twin with memory, Exa research missions, a council of advisors and twin-to-twin negotiation (Mastra + Exa + Kernel, deployed on Fly.io)",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "twin": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "^1.74.0",
    "@mastra/mcp": "^2.1.2",
    "@onkernel/sdk": "^0.119.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "mastra": "^1.32.1",
    "typescript": "^5.9.3"
  }
}
