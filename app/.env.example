# Live conversational chat. Server-only credentials; never use NEXT_PUBLIC_.
# Copy to .dev.vars for the local Worker runtime and restart the frontend.
# An OpenAI-compatible provider (including OpenRouter):
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4.1-mini

# Alternatives when a generic provider is not configured:
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Also used as chat fallback if the compatible provider has exhausted credits or is unavailable.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Real public web research used when the conversation needs current facts:
EXA_API_KEY=

# Twin connections and conversations require the backend registration key.
# The deployed Nook backend is the default; override for a different installation.
NOOK_API_URL=https://nook-alhinai-api.fly.dev
NOOK_REGISTRATION_KEY=

# Optional for local Worker previews only; public deployments still require sign-in.
NOOK_ALLOW_LOCAL_CHAT=false

# Optional workflow service credentials
KERNEL_API_KEY=
FLY_API_TOKEN=
