# Server-only configuration. Copy to .dev.vars for local development.
# Never prefix secrets with NEXT_PUBLIC_ or VITE_. Restart after editing.
# OpenRouter (or another OpenAI-compatible provider)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4.1-mini

# Optional Google Gemini fallback when AI_API_KEY is empty
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Optional direct OpenAI fallback when AI_API_KEY is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional workflow service credentials
EXA_API_KEY=
KERNEL_API_KEY=
FLY_API_TOKEN=
NOOK_REGISTRATION_KEY=

# Preferred migrated Nook backend, server-side only
NOOK_API_URL=https://nook-alhinai-api.fly.dev
