# Required: the agents run on Claude.
ANTHROPIC_API_KEY=

# Recommended: opens each event page in a Kernel cloud browser. Without it, pages are read from
# Exa's cached copies and RSVP status may be stale.
KERNEL_API_KEY=

# Needed for real use. Exa's hosted MCP server connects without a key, but keyless use is capped
# (the open-source server defaults to 2 calls/s and 50 calls/day per IP); one event scout exceeds that.
EXA_API_KEY=

# Required when deployed: bearer token for /twin/* and /api/*. Generate with `openssl rand -hex 32`.
TWIN_API_TOKEN=

# Optional.
# TWIN_MODEL=anthropic/claude-opus-5-5
# TWIN_EFFORT=high

# Where events.md and memory/ live. Set an absolute path: the CLI defaults to the directory you run
# it from, but `npm run dev` and `npm run start` run from a different working directory, so
# without this the server and the CLI would not share memory or output.
# TWIN_OUTPUT_DIR=/absolute/path/to/this/project
# TWIN_MEMORY_DIR=/absolute/path/to/this/project/memory
