{
  "name": "nook",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend/nook"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm --prefix backend/nook run build",
    "start": "npm --prefix backend/nook run start",
    "dev": "npm --prefix backend/nook run dev",
    "typecheck": "npm --prefix backend/nook run typecheck",
    "test": "npm --prefix backend/nook run test",
    "demo": "npm --prefix backend/nook run demo",
    "verify:live": "npm --prefix backend/nook run verify:live",
    "frontend:install": "npm --prefix app ci",
    "frontend:dev": "npm --prefix app run dev -- --host 127.0.0.1",
    "frontend:build": "npm --prefix app run build",
    "frontend:typecheck": "npm --prefix app run typecheck",
    "frontend:test": "npm --prefix app test"
  }
}
